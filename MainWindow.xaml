<Window x:Class="MidiLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIDILINK" Height="500" Width="600"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Window.Resources>
        <!-- Add global resources here if needed -->
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Top bar: Add link, Refresh, Status, Disable all, Theme selector -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button Content="＋ Add link" Width="95" Height="30" Margin="4,0,8,0" Click="AddConnection_Click"/>
                <Button Content="Refresh" Width="95" Height="30" Margin="0,0,8,0" Click="RefreshButton_Click"/>
            </StackPanel>
            <ToggleButton x:Name="DisableAllButton"
                          Content="Disable all"
                          Grid.Column="1"
                          IsChecked="False"
                          Click="DisableAllButton_Click"
                          Width="95"
                          Height="30"/>

            <!-- Theme selector ComboBox -->
            <ComboBox x:Name="ThemeSelector" Grid.Column="2" Width="45"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="Transparent"
              BorderBrush="Transparent"
              Padding="4,0,0,0"
              Margin="10,5,5,5"
              SelectionChanged="ThemeSelector_SelectionChanged"
              FontWeight="Medium">
                <ComboBox.Template>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Displayed area -->
                            <ToggleButton x:Name="ToggleButton"
                              Background="Transparent"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              Focusable="False">
                                <ContentPresenter Margin="4"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Content="{TemplateBinding SelectionBoxItem}"/>
                            </ToggleButton>

                            <!-- Popup with rounded corners -->
                            <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                                <Border BorderBrush="Gray"
                            BorderThickness="0"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </ComboBox.Template>

                <!-- Style for rounded ComboBox items -->
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                CornerRadius="8"
                                Padding="10,8,10,8"
                                Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Hover -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
                                        </Trigger>
                                        <!-- Selected -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>

                <!-- Light theme -->
                <ComboBoxItem Tag="Light">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="WeatherSunny" 
                                     Width="20" Height="20" 
                                     Foreground="Gold"/>
                        <TextBlock Margin="6,0,0,0" Text="Light"/>
                    </StackPanel>
                </ComboBoxItem>

                <!-- Dark theme -->
                <ComboBoxItem Tag="Dark">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="WeatherNight"
                                     Width="20" Height="20" 
                                     Foreground="DarkSlateBlue"/>
                        <TextBlock Margin="6,0,0,0" Text="Dark"/>
                    </StackPanel>
                </ComboBoxItem>

                <!-- System theme -->
                <ComboBoxItem Tag="System">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ThemeLightDark"
                                     Width="20" Height="20"/>
                        <TextBlock Margin="6,0,0,0" Text="System"/>
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>
        </Grid>

        <!-- Keyboard Bottom Panel -->
        <DockPanel LastChildFill="True" DockPanel.Dock="Bottom" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Piano Keyboard -->
                <Grid x:Name="PianoPanel" Grid.Row="0" Background="Transparent" Height="100" Width="500" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.Resources>
                        <Style x:Key="WhiteKeyStyle" TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="1.3"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="1,0,1,0"/>
                            <Setter Property="Grid.ColumnSpan" Value="3"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="04">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#DDD"/>
                                                <Setter TargetName="Bd" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleY="0.95"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="BlackKeyStyle" TargetType="Button">
                            <Setter Property="Background" Value="Black"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="2,0,2,0"/>
                            <Setter Property="Height" Value="60"/>
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                            <Setter Property="Panel.ZIndex" Value="2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0,0,4,4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#222"/>
                                                <Setter TargetName="Bd" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleY="0.95"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <!-- Touches blanches -->
                    <Button Grid.Column="0" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="53" />
                    <Button Grid.Column="2" Style="{StaticResource BlackKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="54" />
                    <Button Grid.Column="3" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="55" />
                    <Button Grid.Column="5" Style="{StaticResource BlackKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="56" />
                    <Button Grid.Column="6" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="57" />
                    <Button Grid.Column="8" Style="{StaticResource BlackKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="58" />
                    <Button Grid.Column="9" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="59" />
                    <Button Grid.Column="12" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="60" />
                    <Button Grid.Column="14" Style="{StaticResource BlackKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="61" />
                    <Button Grid.Column="15" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="62" />
                    <Button Grid.Column="17" Style="{StaticResource BlackKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="63" />
                    <Button Grid.Column="18" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="64" />
                    <Button Grid.Column="21" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="65" />
                    <Button Grid.Column="23" Style="{StaticResource BlackKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="66" />
                    <Button Grid.Column="24" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="67" />
                    <Button Grid.Column="26" Style="{StaticResource BlackKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="68" />
                    <Button Grid.Column="27" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="69" />
                    <Button Grid.Column="29" Style="{StaticResource BlackKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="70" />
                    <Button Grid.Column="30" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="71" />
                    <Button Grid.Column="33" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="72" />
                    <Button Grid.Column="35" Style="{StaticResource BlackKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="73" />
                    <Button Grid.Column="36" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="74" />
                    <Button Grid.Column="38" Style="{StaticResource BlackKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="75" />
                    <Button Grid.Column="39" Style="{StaticResource WhiteKeyStyle}" PreviewMouseDown="PianoKey_Down" PreviewMouseUp="PianoKey_Up" Tag="76" />
                </Grid>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,0,0" Foreground="Gray" Visibility="Collapsed"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="ToggleKeyboardPanel" Grid.Column="0" Width="40" Height="30" Margin="0,4,8,0"
                            Checked="ToggleKeyboardPanel_Checked"
                            Unchecked="ToggleKeyboardPanel_Unchecked"
                            Padding="0">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>

                            <!-- Bind explicite pour forcer l'héritage si besoin -->
                            <materialDesign:PackIcon Kind="Piano"
                             Width="24" Height="24"/>
                        </ToggleButton>

                        <ComboBox Grid.Column="1" x:Name="OutKeyboardCombo" Height="30" Margin="0,4,8,0" Padding="8,0,0,0"
                            ItemsSource="{Binding DataContext.OutDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                            SelectionChanged="OutKeyboardCombo_SelectionChanged"
                            SelectedValuePath="Id"
                            DisplayMemberPath="Display"
                            HorizontalAlignment="Stretch"
                            Visibility="Hidden"/>
                    </Grid>
                </StackPanel>

            </Grid>
        </DockPanel>

        <!-- Connection list -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Connections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Padding="10" Margin="0,0,0,8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Margin="0,0,8,4">
                                    <!-- Vertical stack for IN/OUT selection -->
                                    <StackPanel>
                                        <TextBlock Text="IN" FontWeight="Bold" Margin="4,0,0,4"/>
                                        <ComboBox x:Name="InCombo"
                                        ItemsSource="{Binding DataContext.InDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                                        SelectedValue="{Binding InId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="Display"
                                        HorizontalAlignment="Stretch"/>

                                        <TextBlock Text="OUT" FontWeight="Bold" Margin="4,20,0,4"/>
                                        <ComboBox x:Name="OutCombo"
                                        ItemsSource="{Binding DataContext.OutDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                                        SelectedValue="{Binding OutId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="Display"
                                        HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Arrow icon between IN and OUT -->
                                    <materialDesign:PackIcon Kind="ArrowDownBold"
                                     Width="25" Height="25" 
                                     Foreground="{Binding ArrowBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Margin="0,25,0,0"/>
                                </Grid>

                                <StackPanel Grid.Column="1">
                                    <!-- Enable/Disable connection -->
                                    <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding IsInactive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Content="{Binding ActiveLabel}"
                                              MinWidth="110" Height="45" Margin="4,15,4,4"/>

                                    <!-- Delete connection -->
                                    <Button Grid.Column="2" Content="Delete" MinWidth="110" Height="45" Margin="4,9,4,4"
                                        Click="RemoveConnection_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>



    </DockPanel>
</Window>
